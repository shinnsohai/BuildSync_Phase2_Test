/* __EN__ (module __ID__): only what the shared styles do not already give. Prefix every class with the module id so modules never collide. */
.__ID__-late { display: inline-block; padding: 1px 8px; border-radius: 999px; background: #fde4e4; color: #b32d2d; font-size: 11.5px; font-weight: 600; }
.__ID__-item .__ID__-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 6px 0; font-size: 12.5px; color: #5b6477; }
.__ID__-item.done { opacity: .65; }
